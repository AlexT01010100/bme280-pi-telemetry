# Native (non-Docker) install on the Pi. Replace <user> with your login
# (and the path, if you cloned somewhere other than your home directory), then:
#   sudo cp deploy/bme-telemetry.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bme-telemetry
[Unit]
Description=BME280 telemetry API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=<user>
# "spi" opens /dev/spidev0.0; "dialout" opens the CO2 sensor's /dev/ttyAMA0
SupplementaryGroups=spi dialout
WorkingDirectory=/home/<user>/pi-air-monitor/service
EnvironmentFile=/home/<user>/pi-air-monitor/service/.env
ExecStart=/home/<user>/pi-air-monitor/service/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
