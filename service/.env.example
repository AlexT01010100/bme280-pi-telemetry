# Copy to service/.env when running uvicorn directly (not needed for docker compose).
BME_DATABASE_URL=postgresql+asyncpg://bme:bme@localhost:5432/telemetry
BME_DRIVER=native            # or "mock" off the Pi
BME_SPI_DEVICE=/dev/spidev0.0
BME_SPI_SPEED_HZ=500000
BME_CO2_DRIVER=mhz19         # "mock" off the Pi, "none" if no CO2 sensor is attached
BME_CO2_SERIAL_DEVICE=/dev/ttyAMA0
BME_SENSOR_ID=bme280-0
BME_SAMPLE_INTERVAL_S=10
BME_RETENTION_DAYS=30        # 0 keeps everything
# BME_LIB_PATH=/path/to/libbme280.so   # defaults to the repo root
# BME_CO2_LIB_PATH=/path/to/libmhz19.so
